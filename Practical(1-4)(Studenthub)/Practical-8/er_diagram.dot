digraph ER {
  graph [rankdir=LR, bgcolor="white", fontname="Helvetica", pad=0.4, nodesep=0.6, ranksep=1.4, label="StudentHub - ER Diagram (Practical 8)", labelloc=t, fontsize=20];
  node  [shape=plaintext, fontname="Helvetica", fontsize=12];
  edge  [fontname="Helvetica", fontsize=11, color="#065f46", penwidth=1.6];

  students [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#065f46">
      <TR><TD BGCOLOR="#065f46" COLSPAN="2"><FONT COLOR="white"><B>students</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id  INT</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">student_id  VARCHAR(15)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">fullname  VARCHAR(60)</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">email  VARCHAR(100)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">mobile  CHAR(10)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">course  VARCHAR(50)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">semester  TINYINT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">gender  ENUM</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">sgpa  DECIMAL(3,2)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">attendance  TINYINT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status  ENUM(active,inactive)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at  TIMESTAMP</TD></TR>
    </TABLE>>];

  registrations [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#d97706">
      <TR><TD BGCOLOR="#d97706" COLSPAN="2"><FONT COLOR="white"><B>registrations</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id  INT</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">student_id  INT  &#8594; students.id</TD></TR>
      <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">event_id  INT  &#8594; events.id</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">registered_at  TIMESTAMP</TD></TR>
      <TR><TD ALIGN="LEFT">UQ</TD><TD ALIGN="LEFT">(student_id, event_id)</TD></TR>
    </TABLE>>];

  events [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#0284c7">
      <TR><TD BGCOLOR="#0284c7" COLSPAN="2"><FONT COLOR="white"><B>events</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id  INT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">title  VARCHAR(150)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">category  VARCHAR(30)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">event_date  DATE</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">event_time  VARCHAR(30)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">venue  VARCHAR(120)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">organizer  VARCHAR(120)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">description  TEXT</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">status  ENUM(open,closed)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">poster  VARCHAR(255)</TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT">created_at / updated_at</TD></TR>
    </TABLE>>];

  students -> registrations [label=" 1 : N  (a student makes many registrations)", arrowhead=crow, arrowtail=tee, dir=both];
  events   -> registrations [label=" 1 : N  (an event has many registrations)", arrowhead=crow, arrowtail=tee, dir=both, constraint=false];
}
